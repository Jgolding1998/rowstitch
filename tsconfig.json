{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "lib": ["ES2023"], "types": ["node"], "strict": true,
    "declaration": true, "sourceMap": false, "declarationMap": false,
    "rootDir": "src", "outDir": "dist", "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
